        "leaf_class": "indeterminate_hard_gate_rejected"
      }
    ],
    "rollups_and_denominators": {
      "false_accept_rate": {
        "numerator": "false_accept_count",
        "denominator": "all_oracle_harmful_candidates"
      },
      "qwen_false_reject_rate": {
        "numerator": "qwen_false_reject_count",
        "denominator": "oracle_beneficial_candidates_reaching_qwen"
      },
