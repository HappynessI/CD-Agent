      "precision": 0.0,
      "recall": 1.0,
      "iou": 0.0,
      "f1": 0.0
    },
    "degraded_if": [
      "delta_iou_below_negative_epsilon",
      "delta_f1_below_negative_epsilon",
      "metric_tie_and_tp_decreases",
      "metric_tie_and_fp_increases",
      "metric_tie_and_fn_increases"
    ],
    "oracle_beneficial_if": "delta_iou_above_epsilon_and_delta_f1_above_epsilon",
    "oracle_harmful_if": "either_metric_decreases_or_metric_tie_with_worse_counts",
    "unclassifiable_candidates": "indeterminate"
  },
